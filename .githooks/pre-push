#!/bin/sh
# Blocks force-pushing (rewriting history that is already on GitHub).
#
# On 2026-07-20 something force-pushed the main branch of this project. Every
# commit id changed and a branch holding a session's work vanished from GitHub.
# AGENTS.md forbids force-pushing for exactly this reason.
#
# GitHub's own branch protection needs a paid plan on a private repository, so
# this hook is the protection actually available here. It stops the mistake on
# this computer.
#
# Turned on with:  git config core.hooksPath .githooks
#
# HOW IT DETECTS A FORCE PUSH: git does NOT tell a pre-push hook whether --force
# was typed — the hook only receives the remote's name and address. What git
# does give, on standard input, is one line per branch being pushed:
#     <local ref> <local sha> <remote ref> <remote sha>
# A normal push only ever adds commits on top of what GitHub already has, so the
# remote's commit is an ancestor of the local one. If it is NOT an ancestor,
# this push would erase commits that exist on GitHub — that is a force push.

zero='0000000000000000000000000000000000000000'
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch — nothing is being rewritten.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # Brand new branch on GitHub — nothing there yet to overwrite.
  case "$remote_sha" in *[!0]*) ;; *) continue ;; esac

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "" >&2
    echo "BLOCKED: this would force-push $remote_ref" >&2
    echo "" >&2
    echo "It would erase commits that are already on GitHub. That is how a" >&2
    echo "session's work was lost on 2026-07-20. AGENTS.md forbids it." >&2
    echo "" >&2
    echo "Pull and merge first instead. In a genuine emergency the bypass is" >&2
    echo "  git push --no-verify" >&2
    echo "" >&2
    blocked=1
  fi
done

exit $blocked
