# OTTO CRM — example server settings. Never commit real secret values.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only database key. Never expose this in index.html.
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase key used by the server to validate Auth access tokens.
# This is not the service-role key and carries no privileged database access.
SUPABASE_PUBLISHABLE_KEY=

ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
INBOUND_WEBHOOK_TOKEN=
