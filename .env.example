# OTTO CRM — optional provider settings.
#
# Core CRM operation is local-first and requires no database/provider variables.
# Business records and local profiles use IndexedDB on the device. Never put
# real keys in this example file or in browser-visible source.
#
# Only configure the variables below when the corresponding optional provider
# feature is intentionally enabled in Vercel.

# Optional AI provider. Ask OTTO, photo/document reading, summaries and drawing
# takeoff can use this server-side key. Without it, the CRM keeps working and
# those flows fall back to local records/manual entry.
NVIDIA_API_KEY=

# Optional model overrides. Leave blank to use the server defaults.
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=

# Optional inbound-email webhook token for provider-backed email intake.
INBOUND_WEBHOOK_TOKEN=
