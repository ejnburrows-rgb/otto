# OTTO CRM — example settings file.
#
# Copy this file to ".env" and fill in the real values. The real ".env" file is
# listed in .gitignore, so it is never uploaded to GitHub. Never put real keys
# in this example file.
#
# The same values must also be set in Vercel:
#   Vercel dashboard -> your project -> Settings -> Environment Variables

# The Supabase project address. Safe to share.
SUPABASE_URL=https://your-project-ref.supabase.co

# The Supabase SECRET key (called "service_role" in the Supabase dashboard,
# under Settings -> API). This one is powerful: it can read and write every
# record. It must ONLY ever live here and in Vercel — never in index.html,
# never in any file that gets committed.
SUPABASE_SERVICE_ROLE_KEY=

# The one AI key. NVIDIA serves every AI feature: Ask OTTO, reading photographed
# checks and receipts, job summaries, and drawing takeoff. Get it from
# build.nvidia.com; it begins "nvapi-". Without it /api/nvidia answers 503 and
# each of those features falls back to saved records or manual entry.
NVIDIA_API_KEY=

# Optional. Which model answers, chosen on the server so no model name is ever
# sent from the browser. Leave both blank to use the built-in defaults
# (meta/llama-3.3-70b-instruct for text, meta/llama-3.2-90b-vision-instruct when
# the request carries an image). Setting these swaps models without a deploy.
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=

INBOUND_WEBHOOK_TOKEN=
