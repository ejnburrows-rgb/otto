# What must NOT be published.
#
# vercel.json sets outputDirectory to ".", so before this file existed the whole
# repository was served from the public domain. Verified on production:
# docs/STATUS.md, docs/OWNER-MANUAL-STEPS.md, AGENTS.md, scripts/*.mjs and
# supabase/migrations/0001_init_schema.sql all returned 200.

# Working documents and process
docs/
*.md
!api/**/*.md
.github/
.githooks/
.vscode/
.cursorrules
.mcp.json

# Test and tooling source. The one existing build stamper is required by Vercel.
scripts/*
!scripts/stamp-version.mjs
evidence/

# Database schema and migrations
supabase/

# Superseded material
legacy/

# Local environment
.env
.env.*
node_modules/
