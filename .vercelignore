# What must NOT be published.
#
# vercel.json sets outputDirectory to ".", so before this file existed the whole
# repository was served from the public domain. Verified on production:
# docs/STATUS.md, docs/OWNER-MANUAL-STEPS.md, AGENTS.md, scripts/*.mjs and
# supabase/migrations/0001_init_schema.sql all returned 200.

# Working documents and process
docs/
*.md
!api/**/*.md
.github/
.githooks/
.vscode/
.cursorrules
.mcp.json

# Test and tooling source. Only the build-time scripts explicitly used by
# vercel.json are sent to Vercel; the build wrapper removes them again before
# the deployment output is published.
scripts/*
!scripts/vercel-build.mjs
!scripts/apply-photo-retry-patch.mjs
!scripts/test-photo-retry-patch.mjs
!scripts/apply-otto-home-patch.mjs
!scripts/test-otto-home.mjs
!scripts/stamp-version.mjs
evidence/
outputs/

# Database schema and migrations
supabase/

# Superseded material
legacy/

# Local environment
.env
.env.*
node_modules/
