# What must NOT be published.
#
# vercel.json sets outputDirectory to ".". Working documents, schemas, and
# development tooling stay excluded. Only the exact build/source-check scripts
# below are admitted during the build, and vercel.json removes scripts/ before
# the deployment output is published.

# Working documents and process
docs/
*.md
!api/**/*.md
.github/
.githooks/
.vscode/
.cursorrules
.mcp.json

# Test and build tooling: deny by default, allow only what the build executes.
scripts/*
!scripts/stamp-version.mjs
!scripts/apply-otto-home-patch.mjs
!scripts/test-otto-home.mjs
!scripts/test-merge.mjs
!scripts/test-inpage-merge.mjs
!scripts/test-pin.mjs
!scripts/test-inbound-email.mjs
!scripts/test-notify.mjs
!scripts/test-quickbooks.mjs
!scripts/test-nvidia.mjs
!scripts/test-photos.mjs
!scripts/test-server-auth.mjs
!scripts/test-demo-seed.mjs
!scripts/test-roles.mjs
!scripts/test-backup-export.mjs
!scripts/test-ui-regressions.mjs
!scripts/qa-check.mjs
evidence/

# Database schema and migrations
supabase/

# Superseded material
legacy/

# Local environment
.env
.env.*
node_modules/
